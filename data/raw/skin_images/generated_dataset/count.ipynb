   "source": [
    "import os\n",
    "\n",
    "image_extensions = {'.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.tiff'}\n",
    "oily_path = 'oily'\n",
    "\n",
    "count = sum(\n",
    "    1 for f in os.listdir(oily_path)\n",
    "    if os.path.splitext(f)[1].lower() in image_extensions\n",
    ")\n",
    "\n",
    "print(f\"Nombre d'images dans oily : {count}\")"
   ]
  }
 ],
